# MCP transport
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PUBLIC_URL=http://127.0.0.1:8000
# Leave empty only for local development. Set a strong value before remote use.
MCP_BEARER_TOKEN=
MCP_QUEUE_TIMEOUT_SECONDS=30
MCP_QUEUE_POLL_INTERVAL_SECONDS=0.1
# Each concurrently running MCP instance must use a unique value from 0 to 31.
SNOWFLAKE_WORKER_ID=1

# Redis Streams buffer between MCP and backend
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM=ticket_commands
REDIS_CONSUMER_GROUP=ticket_backends
REDIS_PENDING_IDLE_MS=120000
REDIS_HEARTBEAT_INTERVAL_SECONDS=30
REDIS_RESULT_TTL_SECONDS=86400

# Backend-only MySQL business facts
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ticket_service
MYSQL_USER=ticket_service
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Backend-only MongoDB operation audit logs
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=ticket_service
MONGO_COLLECTION=conversation_logs

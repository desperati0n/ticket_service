APP_NAME=IT运维助手 Demo
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ticket_service
MYSQL_USER=ticket_service
MYSQL_PASSWORD=change-me
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_PORT=27017
MONGO_DATABASE=ticket_service
MONGO_COLLECTION=conversation_logs
ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_AUTH_ENABLED=true
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me
SSE_RETRY_MS=3000
# LangChain init_chat_model 通用配置。不同提供商还需安装对应集成包。
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_TEMPERATURE=0
MODEL_API_KEY=
MODEL_BASE_URL=
# 也可使用提供商自己的环境变量，例如 OPENAI_API_KEY / OPENAI_BASE_URL。
OPENAI_API_KEY=
OPENAI_BASE_URL=
